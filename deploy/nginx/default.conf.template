map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
geo $realip_remote_addr $trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}
geo $realip_remote_addr $gateway_allowed {
    127.0.0.1/32 1;
    ${GATEWAY_ALLOWED_CIDR} 1;
}
map "$trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}
log_format repricer '$remote_addr $request_method $uri $status $request_time';

server {
    listen 8080;
    server_name _;
    absolute_redirect off;
    server_tokens off;
    access_log /var/log/nginx/access.log repricer;
    client_max_body_size 101m;
    client_body_timeout 30s;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    if ($gateway_allowed != 1) { return 403; }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location = /healthz { access_log off; return 200 'ready\n'; }
    location @unauthenticated_api {
        default_type application/problem+json;
        return 401 '{"title":"Требуется вход","status":401}';
    }
    location = /login { return 302 ${PUBLIC_BASE_URL}/oauth2/start?rd=/; }
    location = /oauth2/auth { return 404; }
    location = /oauth2/userinfo { return 404; }
    location = /_session {
        internal;
        proxy_pass http://oauth2-proxy:4180/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Original-URL ${PUBLIC_BASE_URL}$request_uri;
        proxy_set_header Authorization "";
    }
    location = /oauth2/sign_out {
        return 404;
    }

    location = /api/v1/auth/logout {
        limit_except POST { deny all; }
        auth_request /_session;
        auth_request_set $access_token $upstream_http_x_auth_request_access_token;
        auth_request_set $id_token $upstream_http_authorization;
        proxy_set_header Authorization "Bearer $access_token";
        proxy_set_header X-Auth-Request-Access-Token $access_token;
        proxy_set_header X-Repricer-ID-Token $id_token;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://api:8080;
    }
    location /oauth2/ {
        proxy_pass http://oauth2-proxy:4180;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
    }
    location /auth/admin/ { return 404; }
    location /auth/realms/master/ { return 404; }
    location /auth/ {
        proxy_pass http://keycloak:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }
    location /api/v1/ {
        error_page 401 = @unauthenticated_api;
        auth_request /_session;
        auth_request_set $access_token $upstream_http_x_auth_request_access_token;
        auth_request_set $refreshed_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $refreshed_cookie always;
        proxy_set_header Authorization "Bearer $access_token";
        proxy_set_header X-Auth-Request-Access-Token $access_token;
        proxy_set_header X-Repricer-ID-Token "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://api:8080;
    }
    location = /ws {
        error_page 401 = @unauthenticated_api;
        auth_request /_session;
        auth_request_set $access_token $upstream_http_x_auth_request_access_token;
        proxy_set_header Authorization "Bearer $access_token";
        proxy_set_header X-Auth-Request-Access-Token $access_token;
        proxy_set_header X-Repricer-ID-Token "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_pass http://api:8080;
    }
    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }
}
