<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>ru.oritas.repricer</groupId>
  <artifactId>repricer-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Repricer</name>
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>
  <modules>
    <module>platform</module>
    <module>access</module>
    <module>marketplace</module>
    <module>economics</module>
    <module>automation</module>
    <module>app</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>ru.oritas.repricer</groupId><artifactId>platform</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>ru.oritas.repricer</groupId><artifactId>access</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>ru.oritas.repricer</groupId><artifactId>marketplace</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>ru.oritas.repricer</groupId><artifactId>economics</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>ru.oritas.repricer</groupId><artifactId>automation</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><release>21</release><showWarnings>true</showWarnings><compilerArgs><arg>-Xlint:all</arg></compilerArgs></configuration></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
